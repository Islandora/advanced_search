<?php

/**
 * @file
 * Olivero compatibility for Advanced Search.
 */

use Drupal\Core\Form\FormStateInterface;

/**
 * Implements hook_form_FORM_ID_alter() for the Advanced Search form.
 */
function advanced_search_olivero_form_advanced_search_form_alter(array &$form, FormStateInterface $form_state, $form_id): void {
  if (!_advanced_search_olivero_is_active()) {
    return;
  }

  $form['#attached']['library'][] = 'advanced_search_olivero/form';
}

/**
 * Implements hook_preprocess_views_view().
 */
function advanced_search_olivero_preprocess_views_view(array &$variables): void {
  if (!_advanced_search_olivero_is_active()) {
    return;
  }

  $libraries = $variables['view']->element['#attached']['library'] ?? [];
  if (!in_array('advanced_search/advanced.search.facets_views_ajax', $libraries, TRUE)) {
    return;
  }

  $variables['view']->element['#attached']['library'][] = 'advanced_search_olivero/pager';
}

/**
 * Determines whether Olivero or one of its subthemes is active.
 */
function _advanced_search_olivero_is_active(): bool {
  $active_theme = \Drupal::theme()->getActiveTheme();
  return $active_theme->getName() === 'olivero'
    || array_key_exists('olivero', $active_theme->getBaseThemeExtensions());
}
