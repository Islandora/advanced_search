use Drupal\block\Entity\Block;
use Drupal\Component\Utility\Unicode;
use Drupal\Core\Form\FormStateInterface;
use Drupal\advanced_search\Form\SettingsForm;
use Drupal\advanced_search\Plugin\views\area\AdvancedSearchFormArea;
use Drupal\advanced_search\Plugin\views\area\SearchResultsToolbarArea;
use Drupal\advanced_search\Utilities;
use Drupal\views\ViewExecutable;

/**
 * Implements hook_theme().
 */
function advanced_search_theme() {
  return [
    'facets_result_item__summary' => [
      'template' => 'facets/facets-result-item--summary',
      'base hook' => 'facets_result_item',
    ],
  ];
}

/**
 * Implements hook_views_data().
 */
function advanced_search_views_data() {
  return [
    'views' => [
      'advanced_search_form' => [
        'title' => t('Advanced Search form'),
        'help' => t('Displays the fielded Advanced Search form inside a View.'),
        'area' => ['id' => AdvancedSearchFormArea::PLUGIN_ID],
      ],
      'advanced_search_results_toolbar' => [
        'title' => t('Advanced Search results toolbar'),
        'help' => t('Displays result count, sorting, page size, display mode, and paging controls.'),
        'area' => ['id' => SearchResultsToolbarArea::PLUGIN_ID],
      ],
    ],
  ];
}

/**
 * Implements hook_library_info_alter().
 */
function advanced_search_library_info_alter(&$libraries, $extension) {
  if ($extension === 'facets' && isset($libraries['drupal.facets.views-ajax'])) {
    // Facets 2 provides a Views AJAX integration point. Facets 3 removed that
    // library, so it uses Advanced Search's additive integration instead.
    // https://www.drupal.org/node/2940438
    $path = '/' . \Drupal::service('extension.list.module')->getPath('advanced_search') . '/js/facets';
    $libraries['drupal.facets.views-ajax']['js'] = [
      "$path/facets-views-ajax.js" => [],
    ];
  }
}

/**
 * Implements hook_form_form_id_alter().
 */
function advanced_search_form_block_form_alter(&$form, FormStateInterface $form_state, $form_id) {
  // Islandora removes this condition from the form, but we require it.
  // So we can show blocks for nodes which belong to specific models.
  // Allowing us to add a block for collections only.
  $visibility = [];
  $entity_id = $form['id']['#default_value'];
  $block = Block::load($entity_id);
  if ($block) {
    $visibility = $block->getVisibility();
  }
  $manager = \Drupal::getContainer()->get('plugin.manager.condition');
  $condition_id = 'node_has_term';

  /** @var \Drupal\Core\Condition\ConditionInterface $condition */
  if (array_key_exists($condition_id, $visibility)) {
    $condition = $manager->createInstance($condition_id, $visibility[$condition_id] ?? []);
    $form_state->set(['conditions', $condition_id], $condition);
    $condition_form = $condition->buildConfigurationForm([], $form_state);
    $condition_form['#type'] = 'details';
    $condition_form['#title'] = $condition->getPluginDefinition()['label'];
    $condition_form['#group'] = 'visibility_tabs';
    // Not all blocks are required to give this field.
    $condition_form['term']['#required'] = FALSE;
    $form['visibility'][$condition_id] = $condition_form;
  }
}

/**
 * Implements hook_preprocess_block__facets_summary().
 */
function advanced_search_preprocess_block__facets_summary(&$variables) {
  // Copy data-attributes to the content as the javascript expects
  // there to be no elements between the data declaration and the
  // content of the block.
  foreach ($variables['attributes'] as $key => $value) {
    if (substr($key, 0, 4) === "data") {
      $variables['content_attributes'][$key] = $value;
    }
  }
}

/**
 * Implements hook_preprocess_views_view().
 */
function advanced_search_preprocess_views_view(&$variables) {
  /** @var \Drupal\views\ViewExecutable $view */
  $view = &$variables['view'];
  $form_area = Utilities::getViewAreaConfiguration(
    $view,
    $view->current_display,
    AdvancedSearchFormArea::PLUGIN_ID,
  );
  $toolbar_area = Utilities::getViewAreaConfiguration(
    $view,
    $view->current_display,
    SearchResultsToolbarArea::PLUGIN_ID,
  );
  $views = Utilities::getPagerViewDisplays();
  $legacy_pager = in_array(
    [$view->id(), $view->current_display],
    $views,
    TRUE,
  );

  // Add display classes and AJAX behavior for either integration style.
  if ($toolbar_area !== NULL || $legacy_pager) {
    // Toggle between 'list' and 'grid' display depending on url parameter.
    $config = \Drupal::config(SettingsForm::CONFIG_NAME);
    $default_format = $toolbar_area['override-default-display-mode']
      ?? $config->get(SettingsForm::DISPLAY_DEFAULT);
    $format = \Drupal::request()->query->get('display') ?? $default_format;
    if (!in_array($format, ['list', 'grid'], TRUE)) {
      $format = in_array($default_format, ['list', 'grid'], TRUE)
        ? $default_format : 'list';
    }
    $variables['attributes']['class'][] = 'advanced-search-view';
    $variables['attributes']['class'][] = "view-{$format}";
    $view->element['#attached']['library'][] = 'advanced_search/advanced.search.facets_views_ajax';
  }

  if ($toolbar_area === NULL || !is_array($variables['header'] ?? NULL)) {
    return;
  }

  // Keep every part of an integrated search display in the View's AJAX
  // replacement. Core normally prints exposed widgets after the whole header.
  // Move that render array into a deterministic header sequence and suppress
  // its original position to avoid duplicate controls.
  $header = &$variables['header'];
  $form_key = $form_area['handler_id'] ?? NULL;
  $toolbar_key = $toolbar_area['handler_id'];
  if ($form_key !== NULL && isset($header[$form_key])) {
    $header[$form_key]['#weight'] = -300;
  }
  if (!empty($variables['exposed'])) {
    $header['advanced_search_exposed_filters'] = $variables['exposed'];
    $header['advanced_search_exposed_filters']['#weight'] = -200;
    $variables['exposed'] = [];
  }

  $weight = -100;
  foreach ($header as $key => &$element) {
    if (
      str_starts_with((string) $key, '#')
      || $key === $form_key
      || $key === $toolbar_key
      || $key === 'advanced_search_exposed_filters'
      || !is_array($element)
    ) {
      continue;
    }
    $element['#weight'] = $weight++;
  }
  unset($element);

  if (isset($header[$toolbar_key])) {
    $header[$toolbar_key]['#weight'] = 100;
  }
  unset($header);
}

/**
 * Implements hook_views_pre_view().
 */
function advanced_search_views_pre_view(ViewExecutable $view, $display_id, array &$args) {
  // Allow for recursive searches by disabling contextual filter.
  /** @var \Drupal\advanced_search\AdvancedSearchQuery $advanced_search_query */
  $advanced_search_query = \Drupal::service('advanced_search.query');
  $advanced_search_query->alterView(\Drupal::request(), $view, $display_id);
}

/**
 * Implements hook_preprocess_facets_result_item().
 */
function advanced_search_preprocess_facets_result_item(&$variables) {
  $settings = \Drupal::config(SettingsForm::CONFIG_NAME);
  $length = $settings->get(SettingsForm::FACET_TRUNCATE);
  if (is_numeric($length)) {
    // Limit the length of facets display to at most 32 characters.
    if (is_string($variables['value'])) {
      $variables['value'] = Unicode::truncate(
        $variables['value'],
        $length,
        TRUE,
        TRUE
      );
    }
    elseif (is_string($variables['value']['text']['#title'])) {
      $variables['value']['text']['#title'] = Unicode::truncate(
        $variables['value']['text']['#title'],
        $length,
        TRUE,
        TRUE
          );
    }
  }
}
